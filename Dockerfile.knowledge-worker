FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ocrmypdf tesseract-ocr-eng tesseract-ocr-fra ghostscript \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
COPY api/package.json api/package.json
COPY app/package.json app/package.json
RUN npm ci

COPY api api
CMD ["npm", "run", "knowledge-worker", "-w", "api"]
