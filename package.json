{
  "name": "trovara-os",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "api",
    "app"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently -n api,app -c green,blue \"npm run dev -w api\" \"npm run dev -w app\"",
    "build": "npm run build -w api && npm run build -w app",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w api",
    "seed": "npm run seed -w api",
    "sync-catalog": "npm run sync-catalog -w api",
    "generate-tasks": "bash scripts/generate-recurring-tasks.sh",
    "send-proactive-alerts": "bash scripts/send-proactive-alerts.sh",
    "send-evening-digest": "bash scripts/send-evening-digest.sh",
    "run-data-retention": "bash scripts/run-data-retention.sh",
    "retry-translations": "bash scripts/retry-translations.sh",
    "backup": "bash scripts/backup-db.sh",
    "backup:encrypted": "bash scripts/backup-db-encrypted.sh",
    "backup:production": "bash scripts/backup-production.sh",
    "backup:verify": "bash scripts/verify-backup.sh",
    "backup:restore-test": "bash scripts/restore-test-isolated.sh",
    "restore:db": "bash scripts/restore-db.sh",
    "audit": "npm audit --workspaces --audit-level=high",
    "test": "npm test -w api && npm test -w app",
    "typecheck": "npx tsc --noEmit -p api && npx vue-tsc --noEmit -p app"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "glob": "13.0.6",
    "happy-dom": "^20.11.1"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "brace-expansion": "5.0.9",
    "glob": "$glob",
    "happy-dom": "^20.11.1",
    "ip-address": "10.4.0",
    "rimraf": "5.0.10"
  }
}
