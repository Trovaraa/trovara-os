# Example nginx reverse proxy for Trovara OS (os.trovara.farm)
# API binds to 127.0.0.1:3000; Vite dev/preview on 127.0.0.1:5173.
# Replace certificate paths and upstream ports for your deployment.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

upstream trovara_api {
  server 127.0.0.1:3000;
  keepalive 16;
}

upstream trovara_app {
  server 127.0.0.1:5173;
  keepalive 8;
}

# Redirect plain HTTP to HTTPS
server {
  listen 80;
  listen [::]:80;
  server_name os.trovara.farm;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name os.trovara.farm;

  # TLS (replace with your cert paths or certbot-managed files)
  ssl_certificate     /etc/letsencrypt/live/os.trovara.farm/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/os.trovara.farm/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;
  ssl_session_cache shared:SSL:10m;

  # HSTS (enable only after HTTPS is stable)
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # Security headers (static app shell)
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  # camera/mic=(self) required for field photo/voice evidence capture
  add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=()" always;
  # The app also ships this policy as a meta tag so it survives a server that
  # is missing the header. Keep the two in step; `frame-ancestors` is only
  # honoured here, since a meta tag cannot set it.
  add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'" always;

  # Match API body limit (12 MB) - photo/voice evidence uploads
  client_max_body_size 12m;

  # Real client IP for rate limiting and session metadata
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  # Optional geo (when Cloudflare or nginx geo module sets these):
  # proxy_set_header CF-IPCountry $http_cf_ipcountry;
  # proxy_set_header CF-Region $http_cf_region;
  # proxy_set_header X-Country-Code $geoip_country_code;
  # proxy_set_header X-Region-Code $geoip_region_name;

  # API + auth + shop: prefix ^~ so these win over static-extension regexes
  # (e.g. location ~* \.(jpg|png)$) that would otherwise look for files under the
  # SPA document root and 404 journal/evidence image previews.
  location ^~ /api/ {
    proxy_pass http://trovara_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    add_header Pragma "no-cache" always;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  location ^~ /auth/ {
    proxy_pass http://trovara_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    add_header Pragma "no-cache" always;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  location ^~ /shop/ {
    proxy_pass http://trovara_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    add_header Pragma "no-cache" always;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  # Public journal media, lot JSON, health — must win over any static-extension
  # regex that would otherwise look for .png/.jpg under the SPA document root.
  location ^~ /public/ {
    proxy_pass http://trovara_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location = /health {
    proxy_pass http://trovara_api/health;
    access_log off;
  }

  location = /ready {
    proxy_pass http://trovara_api/ready;
    access_log off;
  }

  # Vue SPA (production: serve built assets from disk or upstream preview)
  location / {
    proxy_pass http://trovara_app;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}
