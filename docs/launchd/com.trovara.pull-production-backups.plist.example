<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.trovara.pull-production-backups</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/potus-mac/Documents/trovara/trovara-os/scripts/pull-production-backups.sh</string>
  </array>

  <!-- Pull once after login/load and every day at 06:30 local time. -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/potus-mac/Library/Logs/trovara-backup-pull.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/potus-mac/Library/Logs/trovara-backup-pull-error.log</string>
</dict>
</plist>
