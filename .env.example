# Copy to .env and set strong local-only values (never commit .env)
# Paste API keys as you obtain them - see docs/INTEGRATIONS.md

# ── Postgres (Docker - published to 127.0.0.1 for laptop dev only) ──────────
POSTGRES_USER=trovara
POSTGRES_PASSWORD=change_me_to_a_strong_random_password
POSTGRES_DB=trovara_os
DATABASE_URL=postgresql://trovara:change_me_to_a_strong_random_password@127.0.0.1:5432/trovara_os

# ── API core ────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=3000
# Unused / do not set: sessions are opaque DB-backed tokens (see api/src/lib/session.ts).
# Nothing in the API reads SESSION_SECRET for auth.
# SESSION_SECRET=
NODE_ENV=development

# Number of trusted reverse-proxy hops in front of the API (for client IP / rate limits).
# Production default is 1 (nginx → API). Set 0 in bare local runs without a proxy.
# TRUSTED_PROXY_HOPS=1

# AES-256-GCM key for encrypting TOTP secrets at rest (32 bytes as 64-char hex or base64).
# Required in production before enabling owner 2FA. Alternative: TOTP_KEY_DERIVATION_SECRET.
# Generate: openssl rand -hex 32
# TOTP_ENCRYPTION_KEY=

# Production only: customer WhatsApp/Telegram order bots require an owner with 2FA
# enabled. Set true only for emergency bypass (staff butler is unaffected).
# ALLOW_CUSTOMER_CHANNELS_WITHOUT_TOTP=false

# Production / LAN: comma-separated SPA origins (farm Wi‑Fi example below)
# Include OS app origins. Marketing shop/lot pages should prefer same-origin
# /shop-api and /lot-api proxies; if the marketing site calls the API directly,
# also list https://trovara.farm (and www) plus local marketing ports.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://192.168.178.244:5173

# ── Seed user passwords (supervisor / worker / sales demo accounts) ─────────
SEED_SUPERVISOR_PASSWORD=change_me_supervisor_dev_password
SEED_WORKER_PASSWORD=change_me_worker_dev_password
# SEED_SALES_PASSWORD=change_me_sales_dev_password
# Optional legacy alias used by some cron scripts if CRON_OWNER_PASSWORD is unset.
# SEED_OWNER_PASSWORD=change_me_owner_dev_password

# Break-glass emergency login (checked from env at sign-in — not stored in DB).
# Restart API after changing. Logs a security event on use.
# Env-password login is OFF unless BREAK_GLASS_ENABLED=true (arm only for recovery,
# then unset and restart). Sessions from env break-glass last 1 hour.
BREAK_GLASS_PASSWORD=change_me_break_glass_password
# BREAK_GLASS_EMAIL=owner@trovara.farm
# Local/dev convenience only — leave unset/false in production:
# BREAK_GLASS_ENABLED=true

# ── Owner registration (single-use tokens; not an env secret) ───────────────
# Do NOT set a shared OWNER_REGISTRATION_SECRET in production. Mint a one-time
# token on the server instead, then paste it into /register once:
#
#   cd /path/to/trovara-os
#   source "$HOME/.nvm/nvm.sh" && nvm use 22
#   npm run reg-token -w api -- --ttl=2 --label="initial founder"
#
# --ttl=2  → expires in 2 hours (omit for default 24h)
# --label  → audit note only
# The CLI prints the token once. It is consumed on first successful registration.
# After the first owner exists, mint further tokens via
# POST /auth/registration-tokens (owner session) instead of the CLI.
# Legacy fallback only (leave empty in production):
# OWNER_REGISTRATION_SECRET=

# Production safety switches. Keep false/unset after the clean go-live rebuild.
ALLOW_FULL_DB_RESET=false
LIVE_MODE_OVERRIDE=false
# ── Frontend (Vite - leave empty in dev to use the Vite proxy on :5173) ─────
VITE_API_URL=

# Production build: set before `npm run build -w app`
# VITE_API_URL=https://api.your-domain.com

# Public SPA URL shown in buyer-facing lot links in the app UI (frontend build-time).
# Set before `npm run build -w app`; should match PUBLIC_APP_URL below.
# If unset, the app falls back to the browser's current origin.
# VITE_PUBLIC_APP_URL=https://os.trovara.farm

# Public SPA URL for QR codes and lot pages (production, backend)
# PUBLIC_APP_URL=https://os.trovara.farm
# Local default (when unset and NODE_ENV != production): http://127.0.0.1:5173
# Marketing site origin. When set, buyer-facing lot QR/share links use
# `${PUBLIC_MARKETING_URL}/lot/:farmSlug/:token` (brand UI); certificates/labels
# stay on PUBLIC_APP_URL. Also used for shop account links in order emails.
# PUBLIC_MARKETING_URL=https://trovara.farm
# Frontend build-time mirror of PUBLIC_MARKETING_URL (Traceability “copy link” UI).
# VITE_PUBLIC_MARKETING_URL=https://trovara.farm

# ── Marketing newsletter (Resend Contacts + Segment) ────────────────────────
# Use a full-access key: contact/segment sync is not available to sending-only keys.
# Verify the RESEND_FROM domain in Resend before enabling public signup.
# RESEND_API_KEY=
# RESEND_FROM="Trovara <newsletter@trovara.farm>"
# Create a Segment (not a deprecated Audience) and paste its ID.
# RESEND_NEWSLETTER_SEGMENT_ID=
# Signing secret for POST /public/newsletter/webhook (starts with whsec_).
# RESEND_WEBHOOK_SECRET=
# Version shown in the consent record; increment when consent language changes.
# NEWSLETTER_CONSENT_VERSION=1.0

# ── Email/SMS delivery ───────────────────────────────────────────────────────
# Preferred: Resend for transactional mail (password reset, critical alerts).
# Reuses RESEND_API_KEY from the newsletter section. Optionally set EMAIL_FROM
# for ops mail; otherwise RESEND_FROM is used.
# Website contact and product-waitlist staff alerts use this same transactional
# path. They require no additional environment variables; submissions remain
# stored in PostgreSQL when email delivery is disabled.
# EMAIL_FROM="Trovara OS <no-reply@trovara.farm>"
# Explicit recipients for website contact and product-waitlist alerts.
# Comma-separate multiple real mailboxes. When unset, active Owner/Sales users
# are used, excluding the break-glass account.
# MARKETING_LEAD_NOTIFICATION_EMAILS=info@trovara.farm
# Version stored on contact/waitlist consent records; bump when notice language changes.
# MARKETING_LEAD_CONSENT_VERSION=1.0
# EMAIL_DELIVERY_REQUIRED=false
#
# SMS remains provider-neutral through an HTTPS webhook adapter.
# SMS_WEBHOOK_URL=https://notifications.example.com/sms
# SMS_WEBHOOK_TOKEN=
# SMS_FROM=Trovara
# SMS_DELIVERY_REQUIRED=false

# ── Weather (Today view + Trovara OS Advisory weather tips) ─────────────────
# Provider: openweathermap (default, commercially licensed) or open-meteo
# (use paid/self-hosted base URL for commercial SaaS — set WEATHER_API_BASE_URL).
# WEATHER_PROVIDER=openweathermap
# WEATHER_PROVIDER=open-meteo
# WEATHER_API_KEY=                    # required for openweathermap
# WEATHER_API_BASE_URL=
# WEATHER_CACHE_TTL_MINUTES=30
# WEATHER_STALE_MAX_HOURS=6
# Alert thresholds (metric) — used for Today actions + Advisory weather risks:
# WEATHER_HEAT_C=35
# WEATHER_COLD_C=15
# WEATHER_WIND_KMH=40
# WEATHER_RAIN_MM=5
# WEATHER_RAIN_PROB=60
# Also set farm latitude / longitude / timezone in Settings so forecasts resolve.

# ── Trovara OS Advisory marketplace search (optional) ───────────────────────
# Live location-biased product links for Advisory tips / Track / diagnosis.
# If MARKETPLACE_SEARCH_API_KEY is unset, LLM suggests local product types
# (no buy URLs — shown as “suggested for your area”).
# MARKETPLACE_SEARCH_PROVIDER=serpapi
# MARKETPLACE_SEARCH_API_KEY=

# ── Meta WhatsApp Cloud API (optional - see docs/INTEGRATIONS.md) ───────────
# Staff butler number (internal farm Q&A). Separate phone number ID from customer.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Customer ordering number (public). Leave blank to disable customer WhatsApp.
# Webhook routes by metadata.phone_number_id — same callback URL for both numbers.
WHATSAPP_CUSTOMER_PHONE_NUMBER_ID=
# Optional: dedicated token for the customer number. Falls back to WHATSAPP_ACCESS_TOKEN.
# WHATSAPP_CUSTOMER_ACCESS_TOKEN=
# App secret (Meta dashboard → App settings → Basic) - REQUIRED in production;
# enables X-Hub-Signature-256 verification of inbound webhooks
META_APP_SECRET=

# ── Telegram bot (easiest test channel - see docs/TELEGRAM-COPILOT.md) ──────
# Staff butler (internal farm Q&A). Separate BotFather bot from the customer bot.
TELEGRAM_BOT_TOKEN=
# polling (no public URL needed) or webhook - applies to both bots
TELEGRAM_MODE=polling
# Only needed in webhook mode (openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=

# ── Customer order bot (public ordering/tracking) ─────────────────────────────
# A SECOND @BotFather bot, kept separate from the staff butler so it never
# touches internal farm data. Leave blank to disable customer ordering.
TELEGRAM_CUSTOMER_BOT_TOKEN=
# Generate: openssl rand -hex 24
TELEGRAM_CUSTOMER_WEBHOOK_SECRET=
# Which farm the customer bot sells for (single-farm pilot). Defaults to the only farm.
TELEGRAM_CUSTOMER_FARM_SLUG=trovara-farm
# Preferred UUID pin for all public customer surfaces, including the Journal.
# CUSTOMER_FARM_ID=

# Optional Netlify build hook called after published Journal content changes.
# NETLIFY_JOURNAL_BUILD_HOOK=

# ── AI / LLM (optional - OpenAI or OpenAI-compatible endpoint) ─────────────
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# gpt-5 (smartest, slowest) · gpt-5-mini (fast, good) · gpt-4o-mini (fastest)
LLM_MODEL=gpt-5-mini
# Reasoning models only: minimal | low | medium | high
LLM_REASONING_EFFORT=low
# Voice-note transcription (Yoruba / Pidgin / French / English auto-detected)
LLM_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Butler voice replies (OpenAI TTS)
LLM_TTS_MODEL=tts-1
LLM_TTS_VOICE=alloy
LLM_TTS_FORMAT=mp3
# off | voice_replies | always
BUTLER_TTS_MODE=voice_replies
# Purge task photo/voice evidence older than this (days) - run-data-retention cron
# Also redacts old Butler chat text, purges expired sessions, and nulls stale contact phones.
# DATA_RETENTION_DAYS=365
# SESSION_RETENTION_DAYS=7
# CUSTOMER_CONTACT_RETENTION_DAYS=365
# Max LLM-invoking requests per user per hour (cost control)
AI_RATE_LIMIT_PER_HOUR=60
# Per-farm daily LLM call budget (customer FAQ + staff AI); falls back to deterministic FAQ when exceeded
LLM_DAILY_BUDGET_PER_FARM=500
# Pending-translation retry job (retry-translations cron); backfill uses at most
# BUDGET_SHARE of LLM_DAILY_BUDGET_PER_FARM so interactive butler calls are never starved
# TRANSLATION_RETRY_BATCH_LIMIT=20
# Rows are retired to 'failed' after this many real LLM failures (budget skips don't count)
# TRANSLATION_RETRY_GIVE_UP_ATTEMPTS=6
# TRANSLATION_RETRY_BUDGET_SHARE=0.5
# Customer order abuse caps (bot orders)
MAX_CUSTOMER_ORDER_VALUE_KOBO=50000000
MAX_CUSTOMER_ORDERS_PER_DAY=5
# Ollama local example:
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2

# ── Scheduled jobs / cron (production) ──────────────────────────────────────
# Scripts (run from repo root; load .env; need API up at API_URL):
#   npm run generate-tasks          → recurring task templates
#   npm run send-proactive-alerts   → proactive checks + Advisory tip engine
#   npm run send-evening-digest     → evening owner digest
#   npm run run-data-retention      → evidence / chat / session retention
#
# Preferred auth in production (no password login):
#   openssl rand -hex 32
CRON_SECRET=
# Farm UUID for cron secret auth (required when CRON_SECRET is set)
CRON_FARM_ID=
API_URL=http://127.0.0.1:3000
# Production example: API_URL=https://os.trovara.farm
#
# Fallback login auth (local / legacy only — prefer CRON_SECRET in prod):
CRON_OWNER_EMAIL=owner@trovara.farm
CRON_OWNER_PASSWORD=
#
# Example crontab (farm morning + evening; adjust paths):
#   0 5 * * * cd /path/to/trovara-os && /usr/bin/npm run send-proactive-alerts >> /var/log/trovara-proactive.log 2>&1
#   0 5 * * * cd /path/to/trovara-os && /usr/bin/npm run generate-tasks >> /var/log/trovara-generate-tasks.log 2>&1
#   0 18 * * * cd /path/to/trovara-os && /usr/bin/npm run send-evening-digest >> /var/log/trovara-digest.log 2>&1
#   15 3 * * * cd /path/to/trovara-os && /usr/bin/npm run run-data-retention >> /var/log/trovara-retention.log 2>&1

# ── Private evidence storage ─────────────────────────────────────────────────
# Production: use a persistent path outside the release directory, owned by the API user.
# EVIDENCE_STORAGE_ROOT=/var/lib/trovara-os/evidence

# ── Database backup script (scripts/backup-db.sh - optional overrides) ───────
# BACKUP_DIR=./backups
# PGHOST=127.0.0.1
# PGPORT=5432
# Set to 1 when Postgres runs in this repo's Docker Compose stack; avoids host pg_dump version mismatch.
# USE_DOCKER_PG_TOOLS=1
# Generate: openssl rand -base64 48
# BACKUP_GPG_PASSPHRASE=use_a_long_random_passphrase
# Production verification/restore must require the matching encrypted evidence archive.
# REQUIRE_EVIDENCE_BACKUP=1
# Production orchestration reports; defaults to BACKUP_DIR/reports.
# BACKUP_REPORT_DIR=/var/backups/trovara-os/reports
# Off-server transfer through an rclone remote. Configure the remote outside
# this repository, test it manually, then enable and require delivery.
# BACKUP_RCLONE_DESTINATION=trovara-backups:production/trovara-os
# BACKUP_REMOTE_ENABLED=0
# BACKUP_REMOTE_REQUIRED=0

# ── SaaS billing (future - docs/SAAS-BILLING.md) ───────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# BILLING_ENABLED=false

# ── Paystack (customer order payments) — see docs/PAYSTACK.md ──────────────
# Secret key from Paystack Dashboard → Settings → API Keys (sk_test_… / sk_live_…).
# Required to create payment links and verify webhooks. Leave blank for COD-only.
# PAYSTACK_SECRET_KEY=
# Public key (pk_test_… / pk_live_…) for any client-side Paystack widgets.
# PAYSTACK_PUBLIC_KEY=
# Webhook URL (Paystack Dashboard → Settings → API Keys & Webhooks):
#   POST {PUBLIC_APP_URL}/api/paystack/webhook
# Signature uses HMAC SHA512 of the raw body with PAYSTACK_SECRET_KEY.
# Callback after checkout: {PUBLIC_APP_URL}/pay/callback
