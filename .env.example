# Copy to .env and set strong local-only values (never commit .env)
# Paste API keys as you obtain them — see docs/INTEGRATIONS.md

# ── Postgres (Docker — published to 127.0.0.1 for laptop dev only) ──────────
POSTGRES_USER=trovara
POSTGRES_PASSWORD=change_me_to_a_strong_random_password
POSTGRES_DB=trovara_os
DATABASE_URL=postgresql://trovara:change_me_to_a_strong_random_password@127.0.0.1:5432/trovara_os

# ── API core ────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=3000
SESSION_SECRET=change_me_to_a_long_random_session_secret_min_32_chars
NODE_ENV=development

# Production / LAN: comma-separated SPA origins (farm Wi‑Fi example below)
CORS_ORIGIN=http://127.0.0.1:5173,http://192.168.178.244:5173

# ── Seed user passwords (local dev only — do not use in production) ─────────
SEED_OWNER_PASSWORD=change_me_owner_dev_password
SEED_SUPERVISOR_PASSWORD=change_me_supervisor_dev_password
SEED_WORKER_PASSWORD=change_me_worker_dev_password

# ── Frontend (Vite — leave empty in dev to use the Vite proxy on :5173) ─────
VITE_API_URL=

# Production build: set before `npm run build -w app`
# VITE_API_URL=https://api.your-domain.com

# Public SPA URL for QR codes and lot pages (production)
# PUBLIC_APP_URL=https://os.trovara.farm

# ── Meta WhatsApp Cloud API (optional — see docs/INTEGRATIONS.md) ───────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# App secret (Meta dashboard → App settings → Basic) — REQUIRED in production;
# enables X-Hub-Signature-256 verification of inbound webhooks
META_APP_SECRET=

# ── Telegram bot (easiest test channel — see docs/TELEGRAM-COPILOT.md) ──────
TELEGRAM_BOT_TOKEN=
# polling (no public URL needed) or webhook
TELEGRAM_MODE=polling
# Only needed in webhook mode (openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=

# ── AI / LLM (optional — OpenAI or OpenAI-compatible endpoint) ─────────────
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# gpt-5 (smartest, slowest) · gpt-5-mini (fast, good) · gpt-4o-mini (fastest)
LLM_MODEL=gpt-5-mini
# Reasoning models only: minimal | low | medium | high
LLM_REASONING_EFFORT=low
# Voice-note transcription (Yoruba / Pidgin / English auto-detected)
LLM_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Butler voice replies (OpenAI TTS)
LLM_TTS_MODEL=tts-1
LLM_TTS_VOICE=alloy
LLM_TTS_FORMAT=mp3
# off | voice_replies | always
BUTLER_TTS_MODE=voice_replies
# Purge task photo/voice evidence older than this (days) — run-data-retention cron
# DATA_RETENTION_DAYS=365
# Max LLM-invoking requests per user per hour (cost control)
AI_RATE_LIMIT_PER_HOUR=60
# Ollama local example:
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2

# ── Recurring tasks cron (scripts/generate-recurring-tasks.sh) ─────────────
CRON_OWNER_EMAIL=owner@trovara.farm
CRON_OWNER_PASSWORD=
CRON_FARM_ID=
# Optional internal scheduler auth for alert endpoints
CRON_SECRET=
API_URL=http://127.0.0.1:3000

# ── Database backup script (scripts/backup-db.sh — optional overrides) ───────
# BACKUP_DIR=./backups
# PGHOST=127.0.0.1
# PGPORT=5432
# BACKUP_GPG_PASSPHRASE=use_a_long_random_passphrase

# ── SaaS billing (future — docs/SAAS-BILLING.md) ───────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# BILLING_ENABLED=false
